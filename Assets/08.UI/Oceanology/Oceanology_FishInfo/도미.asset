  m_Script: {fileID: 11500000, guid: 7f43a584b18e36d4186b1e7ec1d40e38, type: 3}
  m_Name: "\uB3C4\uBBF8"
  m_EditorClassIdentifier: 
  fishName: "\uB3C4\uBBF8"
  description: "Sea bream. \uC218\uBA85\uC740 20\uB144 \uC548\uD30E\uC73C\uB85C \uC0DD\uC120\uC911\uC5D0\uC120
    \uAE34 \uD3B8\uC774\uBA70 \uD574\uC870\uB958\uAC00 \uC788\uACE0, \uBAA8\uB798\uC9C8\uC774\uB098
    \uC554\uCD08\uB85C \uB41C \uC218\uC2EC 50m \uC774\uB0B4\uC758 \uC5F0\uC548\uC5D0\uC11C
    \uC11C\uC2DD\uD55C\uB2E4. \r\n\uC6B0\uB9AC\uB098\uB77C\uC5D0 \uB3C4\uBBF8\uB958\uC758
    \uC790\uC6D0\uC774 \uD48D\uBD80\uD558\uBA70, \uC870\uC120\uC2DC\uB300\uC758 '\uB09C\uD638\uC5B4\uBAA9\uC9C0'\uC5D0\uB294
    \u201C\uBA38\uB9AC\uBF08\uAC00 \uB2E8\uB2E8\uD558\uC5EC \uBD80\uB52A\uCE58\uB294
    \uBB3C\uCCB4\uB294 \uBAA8\uB450 \uAE68\uC5B4\uC9C0\uACE0, \uC774\uBE68\uB3C4
    \uAC15\uD558\uC5EC \uC870\uAC1C\uAECD\uC9C8\uC744 \uBD80\uC220 \uC218 \uC788\uC73C\uBA70,
    \uB09A\uC2DC\uB97C \uBB3C\uC5B4\uB3C4 \uACE7\uC798 \uC774\uB97C \uBD80\uB7EC\uB728\uB9B0\uB2E4.\u201D
    \uB77C\uB294 \uAE30\uB85D\uB3C4 \uC874\uC7AC\uD55C\uB2E4.\r\n\uD770\uC0B4 \uC0DD\uC120\uC758
    \uB300\uD45C\uB85C, \uC721\uC9C8\uC774 \uC5F0\uD558\uBA70 \uD0C4\uB825\uC774
    \uC788\uC5B4 \uC5B4\uB5A4 \uBC29\uBC95\uC73C\uB85C \uBA39\uC5B4\uB3C4 \uB9DB\uC774
    \uC77C\uD488\uC774\uBA70 \uC77C\uBCF8\uC5D0\uC11C\uB294 \uD68C\uB85C\uB3C4 \uC778\uAE30\uAC00
    \uB9CE\uB2E4. "
