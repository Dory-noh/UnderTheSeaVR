  m_Script: {fileID: 11500000, guid: 7f43a584b18e36d4186b1e7ec1d40e38, type: 3}
  m_Name: "\uAC70\uBD81"
  m_EditorClassIdentifier: 
  fishName: "\uBC14\uB2E4\uAC70\uBD81"
  description: "Sea turtle. \uD3C9\uADE0 \uC218\uBA85\uC740 80\uB144 \uC815\uB3C4\uC774\uC9C0\uB9CC,
    400\uB144 \uC774\uC0C1\uC744 \uC0B0 \uBC14\uB2E4 \uAC70\uBD81\uC774 \uBC1C\uACAC\uB41C
    \uAE30\uB85D\uB3C4 \uC874\uC7AC. \uBD81\uAD6D\uC744 \uC81C\uC678\uD55C \uBAA8\uB4E0
    \uB300\uC591\uC5D0\uC11C \uC11C\uC11D\uD55C\uB2E4. \r\n\uBAB8 \uAE38\uC774\uB294
    1m\uC5D0\uC11C 1.3m \uC815\uB3C4. \uD314\uACFC \uB2E4\uB9AC\uAC00 \uC9C0\uB290\uB7EC\uBBF8\uB85C
    \uB418\uC5B4 \uC788\uC5B4 \uD5E4\uC5C4\uC5D0 \uC720\uB9AC\uD558\uB2E4. \r\n\uAC70\uB300\uD55C
    \uD5C8\uD30C\uB97C \uAC00\uC9C0\uACE0 \uC788\uC5B4 4\uC2DC\uAC04\uC5D0\uC11C
    7\uC2DC\uAC04\uAE4C\uC9C0 \uC7A0\uC218\uAC00 \uAC00\uB2A5\uD558\uBA70, \uD638\uD761\uC744
    \uC704\uD574 \uD55C \uBC88\uC529 \uC218\uBA74 \uC704\uB85C \uC62C\uB77C\uC640\uC918\uC57C
    \uD55C\uB2E4. \r\n\uB4F1\uB531\uC9C0\uB294 \uB9E4\uC6B0 \uB2E8\uB2E8\uD558\uAE30
    \uB54C\uBB38\uC5D0 \uC0C1\uC5B4 \uB4F1\uC758 \uC721\uC2DD\uB3D9\uBB3C\uC758 \uC2B5\uACA9\uC5D0
    \uBC29\uC5B4\uD560 \uC218 \uC788\uB2E4. \r\n\uC54C\uC744 \uB0B3\uAE30 \uC704\uD574
    \uD574\uC548\uAC00\uB85C \uC62C\uB77C\uC624\uB294\uB370, \uAC13\uD0DC\uC5B4\uB09C
    \uC0C8\uB07C\uB4E4\uC740 \uCC9C\uC801\uB4E4\uC5D0\uAC8C \uCDE8\uC57D\uD558\uC5EC
    \uC9D1\uB2E8\uC0B0\uB780\uC744 \uD558\uAE30\uB3C4 \uD55C\uB2E4. "
